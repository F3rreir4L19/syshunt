# BugHunter — Variáveis de Ambiente
# Copie para .env e preencha os valores

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://bughunter:bughunter_dev@localhost:5432/bughunter
DB_PASSWORD=bughunter_dev

# ─── Redis / Celery ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AI ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Bug Bounty Platforms ───────────────────────────────────
HACKERONE_API_TOKEN=
HACKERONE_USERNAME=

BUGCROWD_API_TOKEN=

INTIGRITI_CLIENT_ID=
INTIGRITI_CLIENT_SECRET=

# ─── Notifications ──────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ─── Dashboard ──────────────────────────────────────────────
# Deixe vazio para sem senha (uso local)
DASHBOARD_PASSWORD=

# ─── Recon Settings ─────────────────────────────────────────
RECON_CONCURRENCY=10
NUCLEI_RATE_LIMIT=150
SCREENSHOT_TIMEOUT=30
MAX_RECON_DEPTH=2

# ─── Storage ────────────────────────────────────────────────
OUTPUT_DIR=./output
