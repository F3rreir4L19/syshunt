# Database
DATABASE_URL=DATABASE_URL=postgresql+psycopg://bughunter:bughunter_dev@db:5432/bughunter
DB_PASSWORD=bughunter_dev

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# AI Provider Selection
# Options: anthropic, openai, ollama
# Leave empty for auto-detection: Anthropic -> OpenAI -> Ollama
AI_PROVIDER=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI-compatible providers
# Works with OpenAI and compatible APIs such as Groq, Together, OpenRouter, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# AI Cache / Rate Limits
AI_CACHE_TTL=86400

# Platforms
HACKERONE_API_TOKEN=
HACKERONE_USERNAME=
BUGCROWD_API_TOKEN=
INTIGRITI_CLIENT_ID=
INTIGRITI_CLIENT_SECRET=

# Discord (optional)
DISCORD_WEBHOOK_URL=

# Dashboard
# Leave empty for local/notebook mode.
# Required for VPS or any network-exposed deployment.
DASHBOARD_PASSWORD=

# Pipeline / Recon Settings
RECON_CONCURRENCY=10
NUCLEI_RATE_LIMIT=150
SCREENSHOT_TIMEOUT=30
MAX_RECON_DEPTH=2

# Storage
OUTPUT_DIR=/tmp/syshunt

# Safety
# false = block localhost, loopback, private IP ranges, link-local and .local targets.
# true = allow local/private targets for lab use.
ALLOW_LOCAL_TARGETS=false
