FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/root/go/bin:${PATH}"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        chromium \
        chromium-driver \
        curl \
        git \
        golang-go \
        nmap \
    && rm -rf /var/lib/apt/lists/*

# Go security tools — currently pinned to @latest.
# TODO (Fase 3.8 backlog): pin each tool to a specific verified version to prevent
#   unexpected breakage when upstream APIs change (e.g. CLI flags or output format).
#   Minimum required: gowitness must be v3+ for `gowitness scan single` syntax.
#   Track at: https://github.com/sensepost/gowitness/releases
RUN go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest \
    && go install github.com/projectdiscovery/httpx/cmd/httpx@latest \
    && go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest \
    && go install github.com/projectdiscovery/katana/cmd/katana@latest \
    && go install github.com/projectdiscovery/dnsx/cmd/dnsx@latest \
    && go install github.com/ffuf/ffuf/v2@latest \
    && go install github.com/lc/gau/v2/cmd/gau@latest \
    && go install github.com/sensepost/gowitness@latest

COPY pyproject.toml README.md ./
COPY core ./core
COPY tools ./tools

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -e .

RUN nuclei -update-templates || true

CMD ["celery", "-A", "core.pipeline.tasks", "worker", "--loglevel=info"]
